# Dependencies
node_modules/

# Secrets
.env
.env.*
!.env.example

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build output
dist/
.astro/

# Media — NEVER commit. See README "Yearly update".
# Masters are originals; derived is pipeline output. Both are uploaded with the
# deploy, not stored in git. media/manifest.json IS committed so the build can
# verify what should be present.
media/*
!media/manifest.json

# Audit artefacts (~19.7 MiB of screenshots)
design-audit/

# Contact/clip sheets generated alongside the audit (~7.7 MiB)
clip-sheet.png
contact-sheet-*.png
gallery-numbered.png

# One-shot migration intermediate (regenerated by `npm run migrate:2025`)
scripts/.gallery-seed.json

# Logs
*.log
npm-debug.log*
