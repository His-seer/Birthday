---
import { Picture } from 'astro:assets';
import { isTodo } from '../lib/content';

interface Props {
  items: Array<{ src: string; alt: string; caption: string; aspect: string }>;
}

const { items } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/**/*.jpg', {
  eager: true,
});

const resolved = items
  .map((item, i) => ({ ...item, image: photos[`/src/assets/${item.src}.jpg`]?.default, i }))
  .filter((item) => item.image);
---

{/*
  The 2025 gallery: the 3D carousel, preserved as the edition's signature
  element — with its WCAG failures removed.

  KEPT (this is what 2025 looked like):
    - one photo centre stage, neighbours rotated back in Z
    - prev/next controls, slide counter

  FIXED:
    - NO AUTOPLAY. 2025 rotated every 4s with no pause control, a WCAG 2.2.2
      failure, and seeing all 14 took 56 seconds of sitting still.
    - Controls have accessible names. 2025's prev/next were icon-only with no
      aria-label, so screen readers announced nothing.
    - The counter is aria-live, so slide changes are announced.
    - Arrow keys are scoped to the carousel. 2025 bound them to `document`, so
      they moved the carousel even when it was off-screen and even while focus
      was in a text field.
    - Fluid. 2025 hard-coded 400x300px, so on a 1440px display a 400px carousel
      sat stranded inside a 1200px container with its buttons ~200px away.
    - Photos are uncropped. 2025 force-cropped every portrait source to 800x600
      landscape and cut heads off.
    - All 13 load as AVIF/WebP at carousel size (~156 KB for the set) instead of
      2025's 806 KB of oversized JPEG. They are NOT lazily deferred per-slide:
      see the note on .c25__item below for why that was tried and reverted.
*/}
<div class="c25" data-count={resolved.length}>
  <div class="c25__stage">
    {
      resolved.map((item, i) => (
        <figure
          class:list={['c25__item', i === 0 && 'is-active', i === 1 && 'is-next']}
          data-index={i}
        >
          {/* Deliberately NO per-photo aspect-ratio here.
              The stage is a fixed 3:4 box and every slide fills it, which is
              also what 2025 did — all 14 photos were baked to an identical
              800x600. Giving each photo its own ratio made a 9:16 image
              compute to 520px inside a 390px stage and spill 94px down into
              the next section. */}
          <Picture
            src={item.image!}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[320, 480, 720]}
            sizes="(max-width: 40rem) 70vw, 22rem"
            alt={isTodo(item.alt) ? `Memory ${i + 1}` : item.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))
    }
  </div>

  <div class="c25__controls">
    <button class="c25__btn" type="button" data-dir="-1" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <p class="c25__counter" aria-live="polite">
      <span data-current>1</span> / {resolved.length}
    </p>

    <button class="c25__btn" type="button" data-dir="1" aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</div>

<style>
  .c25 {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    /* Clip on BOTH axes. Horizontally the rotated neighbours reached past the
       viewport and scrolled the whole page; vertically they (and any tall
       slide) spilled down over the next section's heading. `overflow-x: clip`
       alone fixed only half of that.

       `clip` rather than `hidden` so no scroll container is created, and
       scoped to the carousel rather than the page-wide `overflow-x: hidden`
       the 2025 site used to mask its overflow.

       Padding gives the perspective-magnified edges room before the clip
       bites; offsets also tighten below 40rem. */
    overflow: clip;
    padding-block: 0.75rem;
  }

  .c25__stage {
    position: relative;
    /* Fluid, not the hard-coded 400x300 of 2025. */
    width: min(22rem, 78vw);
    aspect-ratio: 3 / 4;
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .c25__item {
    position: absolute;
    inset: 0;
    margin: 0;
    /* Hidden with visibility/opacity, NOT display:none.
       display:none was an attempt to defer loading the ten off-stage photos.
       It backfired: an image inside a display:none ancestor does not begin
       loading until the ancestor is shown, so the first time you navigated to
       an unvisited slide you got its alt text ("Memory 9") where the photo
       should be. A loading gap on every new slide is a worse bug than the
       bytes it saved — and at AVIF sizes the whole set is ~156 KB against the
       806 KB of JPEG the 2025 site actually shipped. */
    visibility: hidden;
    opacity: 0;
    /* Slides are decorative and never interactive, so they must not intercept
       clicks — on ANY state, including .is-active/.is-prev/.is-next below.

       This is not theoretical. The `is-next` slide is rotated toward the viewer
       inside a perspective stage, so its near edge is magnified and painted
       BELOW the stage box, directly over the next-slide arrow. Real clicks
       landed on the photo and the carousel could not be advanced at all.
       (`elementFromPoint` on the button returned an IMG.) It went unnoticed
       because scripted element.click() bypasses hit-testing entirely. */
    pointer-events: none;
    transition:
      transform 500ms ease,
      opacity 500ms ease;
  }

  /* Absolutely positioned with inset:0 so the box is forced by the stage, not
     by the image's intrinsic ratio. global.css sets `img { height: auto }` for
     CLS safety, and that was winning over a plain `height: 100%` here — which
     is how a tall photo escaped the stage. inset:0 cannot be overridden by
     height:auto: the used height resolves from top/bottom. */
  .c25__item :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .c25__item :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Display crop only — the stored file keeps its full frame, and the 2026
       gallery shows every photo uncropped. */
    object-fit: cover;
    object-position: center 30%;
    border-radius: var(--r-2025-media);
    box-shadow: var(--shadow-2025);
  }

  .c25__item.is-active,
  .c25__item.is-prev,
  .c25__item.is-next {
    visibility: visible;
  }

  /* --c25-drag is set live while a finger/pointer is down, so the slides track
     the gesture instead of only snapping at the end. */
  .c25__item.is-active {
    transform: translateX(var(--c25-drag)) translateZ(0) rotateY(0deg);
    opacity: 1;
    z-index: 3;
  }

  .c25__item.is-prev {
    transform: translateX(calc(var(--c25-offset) * -1 + var(--c25-drag))) translateZ(-240px)
      rotateY(38deg);
    opacity: 0.65;
    z-index: 1;
  }

  .c25__item.is-next {
    transform: translateX(calc(var(--c25-offset) + var(--c25-drag))) translateZ(-240px)
      rotateY(-38deg);
    opacity: 0.65;
    z-index: 1;
  }

  .c25 {
    --c25-offset: 46%;
    --c25-drag: 0px;
  }

  @media (max-width: 40rem) {
    .c25 {
      --c25-offset: 34%;
    }
  }

  .c25__stage {
    /* The browser keeps vertical panning, we take horizontal. Without this the
       page would fight the swipe on a phone — the single most important line
       here. */
    touch-action: pan-y;
    cursor: grab;
  }

  .c25.is-dragging .c25__stage {
    cursor: grabbing;
    user-select: none;
  }

  /* No transition while the finger is down, or the slides lag behind it. */
  .c25.is-dragging .c25__item {
    transition: none;
  }

  .c25__item :global(img) {
    -webkit-user-drag: none;
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .c25__item {
      transition: none;
    }
  }

  .c25__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    /* Belt and braces with the pointer-events rule above: the controls must
       always sit above the 3D-transformed slides in the stacking order, since
       the rotated slides paint outside the stage box. */
    position: relative;
    z-index: 10;
  }

  .c25__btn {
    display: grid;
    place-items: center;
    /* >= 44x44. 2025's were 40x40 and pinned to the container edge, ~200px
       away from the carousel they controlled. */
    width: 44px;
    height: 44px;
    border: 1px solid var(--p-border);
    border-radius: 50%;
    color: var(--p-text);
    background: var(--p-surface);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .c25__btn:hover {
    color: var(--p-white);
    border-color: var(--p-primary);
  }

  .c25__btn:focus-visible {
    outline: 2px solid var(--p-primary);
    outline-offset: 3px;
  }

  .c25__counter {
    margin: 0;
    min-width: 4rem;
    text-align: center;
    color: var(--p-text);
    font-size: var(--t-2025-small);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.c25');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('.c25__item')];
    const counter = root.querySelector<HTMLElement>('[data-current]');
    let index = 0;

    const render = () => {
      const n = items.length;
      items.forEach((el, i) => {
        el.classList.remove('is-active', 'is-prev', 'is-next');
        if (i === index) el.classList.add('is-active');
        else if (i === (index - 1 + n) % n) el.classList.add('is-prev');
        else if (i === (index + 1) % n) el.classList.add('is-next');
      });
      if (counter) counter.textContent = String(index + 1);
    };

    const move = (dir: number) => {
      index = (index + dir + items.length) % items.length;
      render();
    };

    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => move(Number(btn.dataset.dir)));
    });

    // Scoped to the carousel — NOT bound to `document`, which is what made
    // 2025's arrow keys hijack the page.
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        move(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        move(1);
      }
    });

    render();
    // There is deliberately no setInterval here.

    /* ------------------------------------------------------------ swipe --
       Pointer Events cover touch, pen and mouse-drag in one path.

       Axis handling: `touch-action: pan-y` on the stage means the browser
       still owns vertical panning, so scrolling the page past the carousel on
       a phone is unaffected. We additionally refuse to start a drag when the
       first movement is mostly vertical, so a diagonal thumb-scroll is not
       stolen.

       Listeners sit on the STAGE, not the slides — the slides are
       `pointer-events: none` so they cannot intercept the arrows. */
    const stage = root.querySelector<HTMLElement>('.c25__stage');
    if (stage) {
      const AXIS_LOCK = 8; // px of movement before committing to an axis
      const DISTANCE = 0.18; // fraction of stage width that counts as a swipe
      const VELOCITY = 0.45; // px/ms — a quick flick counts even if short

      let startX = 0;
      let startY = 0;
      let dx = 0;
      let tracking = false;
      let committed = false;
      let startedAt = 0;

      const setDrag = (px: number) => root.style.setProperty('--c25-drag', `${px}px`);

      const reset = () => {
        tracking = false;
        committed = false;
        dx = 0;
        root.classList.remove('is-dragging');
        setDrag(0);
      };

      stage.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        startX = event.clientX;
        startY = event.clientY;
        startedAt = event.timeStamp;
        tracking = true;
        committed = false;
        dx = 0;
      });

      stage.addEventListener('pointermove', (event) => {
        if (!tracking) return;
        const mx = event.clientX - startX;
        const my = event.clientY - startY;

        if (!committed) {
          if (Math.abs(mx) < AXIS_LOCK && Math.abs(my) < AXIS_LOCK) return;
          if (Math.abs(my) >= Math.abs(mx)) {
            // Vertical intent — hand it back to the page.
            tracking = false;
            return;
          }
          committed = true;
          root.classList.add('is-dragging');
          try {
            stage.setPointerCapture(event.pointerId);
          } catch {
            /* capture is best-effort */
          }
        }

        dx = mx;
        setDrag(dx);
      });

      const finish = (event: PointerEvent) => {
        if (!tracking && !committed) return;
        const wasCommitted = committed;
        const travelled = dx;
        const elapsed = Math.max(event.timeStamp - startedAt, 1);
        reset();
        if (!wasCommitted) return;

        const width = stage.getBoundingClientRect().width || 1;
        const farEnough = Math.abs(travelled) > width * DISTANCE;
        const fastEnough = Math.abs(travelled) / elapsed > VELOCITY;
        if (farEnough || fastEnough) move(travelled < 0 ? 1 : -1);
      };

      stage.addEventListener('pointerup', finish);
      stage.addEventListener('pointercancel', finish);
      // Losing the pointer (e.g. the browser starts scrolling) must not leave
      // the slides stuck mid-drag.
      stage.addEventListener('lostpointercapture', () => {
        if (committed) reset();
      });
    }
  }
</script>
