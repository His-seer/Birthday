---
import { Picture } from 'astro:assets';
import { getVideo, videoUrl } from '../lib/media';
import { formatDuration } from '../lib/content';

interface Props {
  src: string;
  alt: string;
  aspect: string;
  title: string;
  sizes?: string;
  /** Force a uniform display tile (e.g. "4:5") regardless of the clip's real
   *  aspect. The FILE is untouched — this only frames the poster, and playback
   *  still shows the full frame. Used by the contact-sheet timeline, where the
   *  whole point is a uniform grid. */
  frameAspect?: string;
  /** Play in a full-viewport dialog instead of inside the card.
   *
   *  A portrait clip cannot get meaningfully wider on a desktop page — at any
   *  sensible column width it is ~380px across — so an eight-minute film played
   *  in place is a film nobody watches. The long-form message videos set this;
   *  timeline moments are short and stay inline. */
  expand?: boolean;
}

const {
  src,
  alt,
  aspect,
  title,
  sizes = '(max-width: 720px) 100vw, 640px',
  frameAspect,
  expand = false,
} = Astro.props;

const video = getVideo(src);

// Poster images live in src/assets so Astro can generate AVIF+WebP with srcset
// and intrinsic dimensions. Glob-import them all; the key is the content path.
const posters = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/timeline/**/*-poster.jpg',
  { eager: true }
);
const posterKey = `/src/assets/${src}-poster.jpg`;
const poster = posters[posterKey]?.default;

const [aw, ah] = (frameAspect ?? aspect).split(':').map(Number);
const durationLabel = video ? formatDuration(video.duration) : null;
---

{/*
  AUDIT H4 — the fix, and DESIGN.md 2.6's biggest complaint.

  Last year emitted a bare `<video controls>` with no poster and no preload for
  10 of 14 timeline entries. The browser range-requested all 11 clips on load
  (2,395 KB before any interaction), and what you actually saw ten times was
  Chrome's native control bar sitting inside a card that was otherwise styled.
  DESIGN.md: "The most-repeated visual element on the entire site is browser
  chrome."

  Here the poster IS the visual. Nothing loads until she asks for it:
    - at rest this is an IMAGE with a custom play mark, inside a <button>
    - the <video> element is not in the DOM at all until activated
    - aspect-ratio is set from authored data, so swapping in the video
      cannot shift layout (preserves the measured CLS of 0)
*/}
<figure class="videocard" style={`--aspect: ${aw} / ${ah};`}>
  <div class="videocard__frame">
    {
      poster ? (
        <button
          class="videocard__trigger"
          type="button"
          data-video-mp4={video?.mp4 ? videoUrl(video.mp4) : ''}
          data-video-webm={video?.webm ? videoUrl(video.webm) : ''}
          data-expand={expand ? '' : undefined}
          aria-label={expand ? `Play video full screen: ${title}` : `Play video: ${title}`}
        >
          <Picture
            src={poster}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 800, 1200]}
            sizes={sizes}
            alt={alt}
            loading="lazy"
            decoding="async"
            class="videocard__poster"
          />
          <span class="videocard__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z" />
            </svg>
          </span>
          {durationLabel && <span class="videocard__duration">{durationLabel}</span>}
        </button>
      ) : (
        <div class="videocard__missing">
          <p>Video not built yet — run <code>npm run media:video</code></p>
        </div>
      )
    }
  </div>
</figure>

{
  expand && (
    /* Native <dialog> for the same reasons GalleryGrid uses one: focus
       trapping, Escape-to-close and inertness for the rest of the page, all
       without a line of state management. */
    <dialog class="videocard__modal" aria-label={`${title} — video`}>
      <button class="videocard__modal-close" type="button" aria-label="Close video">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <div class="videocard__modal-stage" />
    </dialog>
  )
}

<style>
  .videocard {
    margin: 0;
  }

  .videocard__frame {
    position: relative;
    aspect-ratio: var(--aspect);
    background: var(--paper-sunk);
    border-radius: var(--radius-photo);
    overflow: hidden;
    box-shadow: var(--elev-photo);
  }

  .videocard__trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    position: relative;
    cursor: pointer;
  }

  .videocard__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-mid) var(--ease);
  }

  /* Custom play affordance — never browser chrome. Sized well above the 44px
     minimum tap target (AUDIT M3: last year's controls were 21x28 and 40x40). */
  .videocard__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--burgundy);
    box-shadow: var(--elev-photo);
    transition:
      transform var(--dur-mid) var(--ease),
      background var(--dur-mid) var(--ease);
  }

  .videocard__play svg {
    /* Optical centring: a triangle looks off-centre when geometrically centred. */
    margin-left: 3px;
  }

  .videocard__duration {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 2px var(--space-2);
    border-radius: var(--radius-surface);
    background: rgb(42 39 36 / 0.72);
    color: var(--paper);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: no-preference) {
    .videocard__trigger:hover .videocard__poster,
    .videocard__trigger:focus-visible .videocard__poster {
      transform: scale(1.02);
    }

    .videocard__trigger:hover .videocard__play {
      transform: scale(1.06);
    }
  }

  .videocard__trigger:focus-visible {
    outline: 2px solid var(--burgundy);
    outline-offset: 3px;
  }

  .videocard__modal {
    width: min(100vw, 100%);
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: var(--ink);
  }

  .videocard__modal::backdrop {
    /* Scrim is deliberately lighter than it was: at 0.92 the page behind was
       already invisible, so a blur would have been paid for and never seen.
       Blur plus a lighter wash keeps a sense of the page still being there. */
    background: rgb(20 18 16 / 0.78);
    backdrop-filter: blur(14px) saturate(0.9);
    -webkit-backdrop-filter: blur(14px) saturate(0.9);
  }

  .videocard__modal-stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    /* Grid items default to min-height:auto, which lets a 1920px-tall video
       push the track past the viewport instead of shrinking to fit. */
    min-height: 0;
    min-width: 0;
  }

  .videocard__modal-stage :global(video) {
    /* Fill the box and letterbox inside it. `max-height: 100%` alone loses to
       the video's intrinsic height and overflows the screen. */
    width: 100%;
    height: 100%;
    min-height: 0;
    /* CONTAIN: the whole frame. Never crop what someone is watching. */
    object-fit: contain;
    background: var(--ink);
  }

  .videocard__modal-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(250 248 245 / 0.9);
    color: var(--ink);
    cursor: pointer;
  }

  .videocard__missing {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--text-caption);
    text-align: center;
  }

  /* CONTAIN, never cover.
  
     The poster above is deliberately cropped when a uniform tile is forced
     (frameAspect on the contact sheet) — that is a grid decision about a still.
     A playing video is different: cropping it throws away picture the viewer
     came to watch, and on a portrait clip in a landscape-ish tile that is the
     top and bottom of every face. This is AUDIT H3.1's mistake — `fit: cover`
     on portrait sources — surviving in the one place the image pipeline fix did
     not reach. Letterboxing against --ink is the honest trade. */
  .videocard__frame :global(video) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--ink);
  }
</style>

<script>
  // Builds the <video> only on activation. Until then no video bytes are
  // requested at all — preload="none" plus not being in the DOM.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement)?.closest<HTMLButtonElement>(
      '.videocard__trigger'
    );
    if (!trigger) return;

    const mp4 = trigger.dataset.videoMp4;
    const webm = trigger.dataset.videoWebm;
    if (!mp4 && !webm) return;

    const video = document.createElement('video');
    video.controls = true;
    video.autoplay = true; // only ever after an explicit user action
    video.playsInline = true;
    video.preload = 'none';

    // Source order matters. VP9/WebM first for the browsers that take it
    // (95.30% support, verified 2026-08-10), H.264/MP4 last as the guaranteed
    // floor at 96.68%. Safari below iOS 17.4 skips WebM and lands on MP4.
    if (webm) {
      const s = document.createElement('source');
      s.src = webm;
      s.type = 'video/webm';
      video.appendChild(s);
    }
    if (mp4) {
      const s = document.createElement('source');
      s.src = mp4;
      s.type = 'video/mp4';
      video.appendChild(s);
    }

    // Long-form films open in the dialog; short timeline clips play in place.
    const figure = trigger.closest('figure');
    const modal = figure?.parentElement?.querySelector<HTMLDialogElement>('.videocard__modal');

    if (trigger.dataset.expand !== undefined && modal) {
      const stage = modal.querySelector<HTMLElement>('.videocard__modal-stage');
      if (!stage) return;
      stage.replaceChildren(video);
      modal.showModal();
      video.focus();
      return;
    }

    const frame = trigger.parentElement;
    if (!frame) return;
    frame.replaceChildren(video);
    video.focus();
  });

  /* Closing must STOP playback, not just hide it. A dialog that merely closes
     leaves an eight-minute soundtrack playing behind the page. */
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const modal = target?.closest<HTMLDialogElement>('.videocard__modal');
    if (!modal) return;
    if (target.closest('.videocard__modal-close') || target === modal) modal.close();
  });

  document.querySelectorAll<HTMLDialogElement>('.videocard__modal').forEach((modal) => {
    modal.addEventListener('close', () => {
      const stage = modal.querySelector('.videocard__modal-stage');
      stage?.querySelectorAll('video').forEach((v) => v.pause());
      stage?.replaceChildren();
    });
  });
</script>
