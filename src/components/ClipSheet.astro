---
import { isTodo } from '../lib/content';
import VideoCard from './VideoCard.astro';

interface Props {
  clips: { src: string; alt: string; aspect: string }[];
}

const { clips } = Astro.props;

/* ONE uniform tile for every clip.
   Thirty-four clips at their native aspects is a ragged wall — tried, and it
   reads as noise. A single 4:5 frame turns them into a contact sheet, which is
   the same device TimelineContactSheet already uses for the same reason.
   The crop is honest here: it frames a POSTER, a still standing in for a film.
   Playback is object-fit: contain, so nothing is cropped when actually watched. */
const TILE = '4:5';

/* Never let an unwritten alt reach the page.
   Passing `clip.alt` straight through put alt="TODO-CONTENT" on 34 images and
   into 68 aria-labels — silent to anyone looking at the screen, and announced
   aloud to anyone using a screen reader. GalleryGrid already guards this way;
   this did not, which is the whole argument for the fallback living in the
   component rather than being remembered at each call site. */
const label = (alt: string, i: number) => (isTodo(alt) ? `Clip ${i + 1}` : alt);
---

{
  clips.length > 0 && (
    <section class="clips" id="clips" aria-labelledby="clips-h">
      <div class="clips__inner u-wrap">
        <h2 class="clips__h u-title reveal" id="clips-h">
          Our Memories in Clips 📽️
          <span class="clips__count u-micro">{clips.length}</span>
        </h2>
        <hr class="u-ornament clips__rule" />
        {/* Same peek rail as the photographs — see GalleryGrid for the full
            reasoning. It matters more here than there: 34 clips one-at-a-time
            would be 34 swipes, so the contact-sheet density that made this a
            grid is preserved by keeping several tiles on screen per view. */}
        <div class="rail">
          <ul
            class="clips__grid"
            role="list"
            tabindex="0"
            data-rail-track
            aria-label="Clips — swipe or scroll sideways"
          >
            {clips.map((clip, i) => (
              <li class="clips__item reveal">
                <VideoCard
                  src={clip.src}
                  alt={label(clip.alt, i)}
                  aspect={clip.aspect}
                  frameAspect={TILE}
                  expand
                  title={label(clip.alt, i)}
                  sizes="(max-width: 640px) 62vw, (max-width: 1024px) 38vw, 340px"
                />
              </li>
            ))}
          </ul>

          <button class="rail__nav rail__nav--prev" type="button" aria-label="Previous clips">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button class="rail__nav rail__nav--next" type="button" aria-label="More clips">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </section>
  )
}

<style>
  .clips {
    padding-block: var(--section-gap);
    background: var(--paper-sunk);
  }

  .clips__h {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
  }

  .clips__count {
    color: var(--ink-muted);
  }

  .clips__rule {
    margin-block: var(--space-4) var(--space-8);
  }

  .rail {
    position: relative;
  }

  .clips__grid {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    padding-block: var(--space-2);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    align-items: flex-start;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--hairline) transparent;
  }

  .clips__grid::-webkit-scrollbar {
    height: 6px;
  }

  .clips__grid::-webkit-scrollbar-thumb {
    background: var(--hairline);
    border-radius: 999px;
  }

  .clips__grid:focus-visible {
    outline: 2px solid var(--burgundy);
    outline-offset: 4px;
  }

  /* THREE per view on desktop, not six.
     The first pass carried the old grid's ~120px tile straight into the rail,
     which put 6.5 clips on screen at ~166px each. That is a thumbnail, and a
     thumbnail is the wrong size for something whose whole job is to make you
     want to press play — you cannot read a face at 166px. 30% gives ~3.3
     visible at 1072px (~320px per tile), and the fractional tile is still the
     cue that the rail continues.

     The cost, stated: 34 clips at 3-up is ~11 swipes rather than ~5. That is
     the trade for tiles you can actually see. */
  .clips__item {
    margin: 0;
    flex: 0 0 62%;
    scroll-snap-align: center;
  }

  @media (min-width: 40rem) {
    .clips__item {
      flex-basis: 38%;
    }
  }

  @media (min-width: 64rem) {
    .clips__item {
      flex-basis: 30%;
    }
  }

  .rail__nav {
    position: absolute;
    top: 40%;
    z-index: 2;
    display: none;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--elev-photo);
    cursor: pointer;
    transition: opacity var(--dur-mid) var(--ease);
  }

  .rail__nav--prev {
    left: calc(var(--space-4) * -1);
  }

  .rail__nav--next {
    right: calc(var(--space-4) * -1);
  }

  @media (hover: hover) and (pointer: fine) {
    .rail__nav {
      display: grid;
    }
  }
</style>

<script>
  import { initRails } from '../lib/rail';

  initRails();
</script>
