---
import { Picture } from 'astro:assets';
import { isTodo } from '../lib/content';

interface GalleryItem {
  src: string;
  alt: string;
  caption: string;
  aspect: string;
  plate: boolean;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/**/*.jpg', {
  eager: true,
});

const resolved = items.map((item, i) => {
  const image = photos[`/src/assets/${item.src}.jpg`]?.default;
  const [aw, ah] = item.aspect.split(':').map(Number);
  return { ...item, image, aw, ah, index: i };
});
---

{/*
  AUDIT M7 + DESIGN.md 2.5 — the 3D carousel does not survive, and not because
  it was the wrong size.

  Measured last year: ONE photo visible at 330x248 (6.3% of a 1440x900
  viewport), two neighbours squashed to 154x153 by rotateY(45deg), and ELEVEN
  at opacity:0 — hidden but fully downloaded (806 KB). Autoplay every 4s with
  no pause control (WCAG 2.2.2 failure), so seeing all 14 took 56 seconds of
  sitting still or 13 deliberate clicks. Nav buttons sat ~200px from the stage
  they controlled on desktop and on top of the subject's face on mobile.

  DESIGN.md: "a 3D rotating carousel optimises for spectacle-per-photo, and
  this content needs comparison-across-photos."

  Replacement: an editorial grid. All photos visible in ~two screens, zero
  interaction required, zero JS to browse, native aspect preserved so portrait
  stays portrait. A lightbox is added for close looking — a complement, not
  the pattern itself.

  DEVIATION FROM DESIGN.md, stated: it recommends promoting 2-3 photos to
  FULL-WIDTH plates. All 13 of these photos are portrait (verified), and a
  full-width portrait at a 1200px content width renders ~1600px tall — a
  screen and a half for one image. Plates here span two grid columns instead,
  which delivers the intended rhythm at a sane height.
*/}
<ul class="gallery" role="list">
  {
    resolved.map((item) => (
      <li class:list={['gallery__cell', item.plate && 'gallery__cell--plate']}>
        {item.image ? (
          <button
            class="gallery__button"
            type="button"
            data-lightbox={item.index}
            aria-label={isTodo(item.alt) ? `View photo ${item.index + 1}` : `View larger: ${item.alt}`}
          >
            <Picture
              src={item.image}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 480, 720, 1080]}
              sizes="(max-width: 640px) 92vw, (max-width: 1024px) 45vw, 30vw"
              alt={isTodo(item.alt) ? `Photograph ${item.index + 1}` : item.alt}
              loading="lazy"
              decoding="async"
              style={`aspect-ratio: ${item.aw} / ${item.ah};`}
            />
          </button>
        ) : (
          <p class="gallery__missing">Missing image: {item.src}</p>
        )}
        {!isTodo(item.caption) && item.caption && (
          <figcaption class="gallery__caption">{item.caption}</figcaption>
        )}
      </li>
    ))
  }
</ul>

{/* Native <dialog> gives focus trapping, Escape-to-close and inertness for
    free — all of which the old carousel lacked entirely. */}
<dialog class="lightbox" aria-label="Photograph viewer">
  <button class="lightbox__close" type="button" aria-label="Close viewer">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>
  <div class="lightbox__stage"></div>
</dialog>

<div class="gallery__sources" hidden>
  {
    resolved.map((item) =>
      item.image ? (
        <Picture
          src={item.image}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[1080, 1440]}
          sizes="90vw"
          alt=""
          loading="lazy"
          data-full={item.index}
        />
      ) : null
    )
  }
</div>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 40rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  /* Tablet is a real breakpoint here. AUDIT M3: last year had exactly ONE
     media query in the entire public stylesheet, at 768px, so 834px was
     completely unhandled. */
  @media (min-width: 64rem) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery__cell--plate {
      grid-column: span 2;
    }
  }

  .gallery__button {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: var(--radius-photo);
    overflow: hidden;
    box-shadow: var(--elev-photo);
    cursor: zoom-in;
    background: var(--paper-sunk);
  }

  .gallery__button :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition:
      transform var(--dur-mid) var(--ease),
      box-shadow var(--dur-mid) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery__button:hover :global(img) {
      transform: scale(1.02);
    }
  }

  .gallery__button:hover {
    box-shadow: var(--elev-lift);
  }

  .gallery__caption {
    margin-top: var(--space-3);
    font-size: var(--text-caption);
    line-height: var(--lh-caption);
    color: var(--ink-muted);
  }

  .gallery__missing {
    padding: var(--space-6);
    background: var(--paper-sunk);
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .lightbox {
    width: min(96vw, 68rem);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: none;
    border-radius: var(--radius-surface);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(42 39 36 / 0.66);
    backdrop-filter: blur(14px) saturate(0.9);
    -webkit-backdrop-filter: blur(14px) saturate(0.9);
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }

  .lightbox__stage :global(img) {
    max-width: 100%;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-photo);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 2;
    /* >= 44x44 tap target (AUDIT M3). */
    width: var(--tap-min);
    height: var(--tap-min);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--elev-photo);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const stage = document.querySelector<HTMLElement>('.lightbox__stage');
  const sources = document.querySelector<HTMLElement>('.gallery__sources');

  if (dialog && stage && sources) {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => {
      button.addEventListener('click', () => {
        const index = button.dataset.lightbox;
        const source = sources.querySelector<HTMLElement>(`[data-full="${index}"]`);
        if (!source) return;

        const clone = source.cloneNode(true) as HTMLElement;
        clone.removeAttribute('hidden');
        const img = clone.querySelector('img');
        const trigger = button.querySelector('img');
        if (img && trigger) {
          img.setAttribute('alt', trigger.getAttribute('alt') ?? '');
          img.setAttribute('loading', 'eager');
        }
        stage.replaceChildren(clone);
        dialog.showModal();
      });
    });

    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());

    // Click the backdrop to dismiss.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => stage.replaceChildren());
  }
</script>
