---
import { Picture } from 'astro:assets';
import { isTodo } from '../lib/content';

interface GalleryItem {
  src: string;
  alt: string;
  caption: string;
  aspect: string;
  plate: boolean;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/**/*.jpg', {
  eager: true,
});

const resolved = items.map((item, i) => {
  const image = photos[`/src/assets/${item.src}.jpg`]?.default;
  const [aw, ah] = item.aspect.split(':').map(Number);
  return { ...item, image, aw, ah, index: i };
});
---

{/*
  AUDIT M7 + DESIGN.md 2.5 — the 3D carousel does not survive, and not because
  it was the wrong size.

  Measured last year: ONE photo visible at 330x248 (6.3% of a 1440x900
  viewport), two neighbours squashed to 154x153 by rotateY(45deg), and ELEVEN
  at opacity:0 — hidden but fully downloaded (806 KB). Autoplay every 4s with
  no pause control (WCAG 2.2.2 failure), so seeing all 14 took 56 seconds of
  sitting still or 13 deliberate clicks. Nav buttons sat ~200px from the stage
  they controlled on desktop and on top of the subject's face on mobile.

  DESIGN.md: "a 3D rotating carousel optimises for spectacle-per-photo, and
  this content needs comparison-across-photos."

  Replacement: an editorial grid. All photos visible in ~two screens, zero
  interaction required, zero JS to browse, native aspect preserved so portrait
  stays portrait. A lightbox is added for close looking — a complement, not
  the pattern itself.

  DEVIATION FROM DESIGN.md, stated: it recommends promoting 2-3 photos to
  FULL-WIDTH plates. All 13 of these photos are portrait (verified), and a
  full-width portrait at a 1200px content width renders ~1600px tall — a
  screen and a half for one image. Plates here get a wider rail tile instead,
  which delivers the intended rhythm at a sane height.

  2026 CLIENT REVISION — grid becomes a horizontal PEEK RAIL.
  Asked for: "can it be a swiping thing instead of scrolling? Then he can tap
  it if he wants it in full view."

  This is NOT a walk-back to last year's 3D carousel, and the distinction is
  the whole point. What AUDIT M1/M3/M7 condemned was: autoplay every 4s with no
  pause control (WCAG 2.2.2), a stage hard-coded to 400x300px, eleven photos at
  opacity:0 that still downloaded 806 KB, and nav buttons ~200px from the thing
  they controlled. None of that is reintroduced here — this rail has no
  autoplay, no timers, no hidden-but-loaded images, it is pure CSS scroll-snap
  (browsing costs zero JS), and its controls sit on the rail itself.

  What IS conceded is DESIGN.md 2.5's adjacency argument — "this content needs
  comparison-across-photos". A peek layout is the compromise: 2-3 tiles stay
  on screen at every breakpoint, so adjacency survives at reduced range rather
  than being destroyed by construction the way a one-at-a-time carousel does.
  Native aspect is still preserved; portrait stays portrait.
*/}
<div class="rail">
  <ul
    class="gallery"
    role="list"
    tabindex="0"
    data-rail-track
    aria-label="Photographs — swipe or scroll sideways"
  >
  {
    resolved.map((item) => (
      <li class:list={['gallery__cell', item.plate && 'gallery__cell--plate']}>
        {item.image ? (
          <button
            class="gallery__button"
            type="button"
            data-lightbox={item.index}
            aria-label={isTodo(item.alt) ? `View photo ${item.index + 1}` : `View larger: ${item.alt}`}
          >
            <Picture
              src={item.image}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 480, 720, 1080]}
              sizes="(max-width: 640px) 92vw, (max-width: 1024px) 45vw, 30vw"
              alt={isTodo(item.alt) ? `Photograph ${item.index + 1}` : item.alt}
              loading="lazy"
              decoding="async"
              style={`aspect-ratio: ${item.aw} / ${item.ah};`}
            />
          </button>
        ) : (
          <p class="gallery__missing">Missing image: {item.src}</p>
        )}
        {!isTodo(item.caption) && item.caption && (
          <figcaption class="gallery__caption">{item.caption}</figcaption>
        )}
      </li>
    ))
  }
  </ul>

  {/* Touch gets swipe for free; a mouse does not. AUDIT M3 flagged last year's
      controls for sitting ~200px from the stage and for 40x40 tap targets, so
      these are anchored to the rail edge and are var(--tap-min) square.

      These are REAL controls, not aria-hidden decoration. The first pass hid
      them from assistive tech on the reasoning that the rail is already
      keyboard-scrollable — but an unnamed <button> is a bare stop for anyone
      who reaches it, and hiding a visible control is how you get an element
      that a screen reader denies exists while a sighted keyboard user is
      looking straight at it. verify.mjs's a11y gate rejected it, correctly. */}
  <button class="rail__nav rail__nav--prev" type="button" aria-label="Previous photographs">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button class="rail__nav rail__nav--next" type="button" aria-label="More photographs">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>

{/* Native <dialog> gives focus trapping, Escape-to-close and inertness for
    free — all of which the old carousel lacked entirely. */}
<dialog class="lightbox" aria-label="Photograph viewer">
  <button class="lightbox__close" type="button" aria-label="Close viewer">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>
  {/* Opening a photograph used to be a dead end: view, close, find your place
      in the rail, open the next. These make the full view its own rail —
      swipe, arrow keys, or these buttons. They wrap, same as the rail arrows,
      so there is no dead end at either edge either. */}
  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous photograph">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next photograph">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class="lightbox__stage"></div>
  {/* Announces the new photograph when it changes. Without this the buttons
      are silent to a screen reader — the picture swaps and nothing is said. */}
  <p class="lightbox__status u-visually-hidden" role="status" aria-live="polite"></p>
</dialog>

<div class="gallery__sources" hidden>
  {
    resolved.map((item) =>
      item.image ? (
        <Picture
          src={item.image}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[1080, 1440]}
          sizes="90vw"
          alt=""
          loading="lazy"
          data-full={item.index}
        />
      ) : null
    )
  }
</div>

<style>
  .rail {
    position: relative;
  }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Tops align; a rail of portraits at native aspect would otherwise stretch
       every tile to the tallest one and re-crop what AUDIT H3.1 fixed. */
    align-items: flex-start;
    /* Keeps a swipe on the rail from turning into a browser back-navigation. */
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    /* Room for the shadow, which a plain overflow container would clip. */
    padding-block: var(--space-2);
  }

  .gallery:focus-visible {
    outline: 2px solid var(--burgundy);
    outline-offset: 4px;
  }

  /* PEEK, at every breakpoint. The basis is deliberately never 100% — a tile
     that fills the viewport is the one-at-a-time carousel DESIGN.md 2.5 argued
     against, and the partial neighbour is also what signals "this scrolls"
     without needing an instruction. */
  .gallery__cell {
    flex: 0 0 78%;
    scroll-snap-align: center;
  }

  @media (min-width: 40rem) {
    .gallery {
      gap: var(--space-8);
    }

    .gallery__cell {
      flex-basis: 44%;
    }
  }

  /* Tablet is a real breakpoint here. AUDIT M3: last year had exactly ONE
     media query in the entire public stylesheet, at 768px, so 834px was
     completely unhandled. */
  @media (min-width: 64rem) {
    .gallery__cell {
      flex-basis: 30%;
    }

    .gallery__cell--plate {
      flex-basis: 46%;
    }
  }

  /* A visible, slim scrollbar is an affordance, not clutter — it is the only
     persistent cue on desktop that there is more rail to the right. */
  .gallery {
    scrollbar-width: thin;
    scrollbar-color: var(--hairline) transparent;
  }

  .gallery::-webkit-scrollbar {
    height: 6px;
  }

  .gallery::-webkit-scrollbar-thumb {
    background: var(--hairline);
    border-radius: 999px;
  }

  .rail__nav {
    position: absolute;
    top: 40%;
    z-index: 2;
    display: none;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--elev-photo);
    cursor: pointer;
    transition: opacity var(--dur-mid) var(--ease);
  }

  .rail__nav--prev {
    left: calc(var(--space-4) * -1);
  }

  .rail__nav--next {
    right: calc(var(--space-4) * -1);
  }

  /* Pointer-only. On touch the swipe IS the control, and these would just sit
     on top of the photographs — which is exactly what AUDIT M3 called out. */
  @media (hover: hover) and (pointer: fine) {
    .rail__nav {
      display: grid;
    }
  }

  .gallery__button {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: var(--radius-photo);
    overflow: hidden;
    box-shadow: var(--elev-photo);
    cursor: zoom-in;
    background: var(--paper-sunk);
  }

  .gallery__button :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition:
      transform var(--dur-mid) var(--ease),
      box-shadow var(--dur-mid) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery__button:hover :global(img) {
      transform: scale(1.02);
    }
  }

  .gallery__button:hover {
    box-shadow: var(--elev-lift);
  }

  .gallery__caption {
    margin-top: var(--space-3);
    font-size: var(--text-caption);
    line-height: var(--lh-caption);
    color: var(--ink-muted);
  }

  .gallery__missing {
    padding: var(--space-6);
    background: var(--paper-sunk);
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .lightbox {
    width: min(96vw, 68rem);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: none;
    border-radius: var(--radius-surface);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(42 39 36 / 0.66);
    backdrop-filter: blur(14px) saturate(0.9);
    -webkit-backdrop-filter: blur(14px) saturate(0.9);
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }

  .lightbox__stage :global(img) {
    max-width: 100%;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-photo);
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--elev-photo);
    cursor: pointer;
  }

  .lightbox__nav--prev {
    left: var(--space-2);
  }

  .lightbox__nav--next {
    right: var(--space-2);
  }

  .lightbox__nav:focus-visible {
    outline: 2px solid var(--burgundy);
    outline-offset: 3px;
  }

  /* A single photograph has nowhere to go, so the controls would be furniture
     that does nothing. Set by the script when the gallery has one item. */
  .lightbox--single .lightbox__nav {
    display: none;
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 2;
    /* >= 44x44 tap target (AUDIT M3). */
    width: var(--tap-min);
    height: var(--tap-min);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--elev-photo);
  }
</style>

<script>
  import { initRails } from '../lib/rail';

  initRails();

  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const stage = document.querySelector<HTMLElement>('.lightbox__stage');
  const sources = document.querySelector<HTMLElement>('.gallery__sources');

  if (dialog && stage && sources) {
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox]')];
    const status = dialog.querySelector<HTMLElement>('.lightbox__status');
    const total = triggers.length;
    let current = 0;

    if (total < 2) dialog.classList.add('lightbox--single');

    function show(index: number) {
      // Wrap both ways, matching the rail arrows — no dead end at either edge.
      current = (index + total) % total;

      const source = sources!.querySelector<HTMLElement>(`[data-full="${current}"]`);
      if (!source) return;

      const clone = source.cloneNode(true) as HTMLElement;
      clone.removeAttribute('hidden');

      /* `data-full` is forwarded by <Picture> onto the <img> ITSELF, not onto
         a wrapping <picture>. So `source` is already the image, and the old
         `clone.querySelector('img')` returned null — which silently skipped
         the whole block below it. Result: every lightbox image opened with
         alt="" (the full-view photo was anonymous to a screen reader) and
         kept loading="lazy" instead of being upgraded to eager.
         Handle both shapes rather than assuming either. */
      const img = clone instanceof HTMLImageElement ? clone : clone.querySelector('img');
      const label = triggers[current]?.querySelector('img')?.getAttribute('alt') ?? '';
      if (img) {
        img.setAttribute('alt', label);
        img.setAttribute('loading', 'eager');
      }

      stage!.replaceChildren(clone);
      if (status) status.textContent = `${label} — ${current + 1} of ${total}`;
    }

    triggers.forEach((button, i) => {
      button.addEventListener('click', () => {
        show(i);
        dialog!.showModal();
      });
    });

    dialog.querySelector('.lightbox__nav--prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lightbox__nav--next')?.addEventListener('click', () => show(current + 1));

    /* Escape and Tab are the dialog's own; only the arrows are ours. Scoped to
       the dialog, not to document — AUDIT M2 found last year binding
       ArrowLeft/ArrowRight on document, so they drove the carousel even while
       it was off-screen and even while focus sat in a text field. */
    dialog.addEventListener('keydown', (event) => {
      if (total < 2) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    /* Touch swipe. Horizontal intent only: a mostly-vertical drag is a scroll
       or a pull-to-refresh, and stealing it would make the photo feel stuck.
       48px threshold so a slightly-diagonal tap never counts as a swipe. */
    let startX = 0;
    let startY = 0;
    dialog.addEventListener(
      'touchstart',
      (event) => {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
      },
      { passive: true }
    );

    dialog.addEventListener(
      'touchend',
      (event) => {
        if (total < 2) return;
        const dx = event.changedTouches[0].clientX - startX;
        const dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) < 48 || Math.abs(dx) <= Math.abs(dy)) return;
        show(dx < 0 ? current + 1 : current - 1);
      },
      { passive: true }
    );

    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());

    // Click the backdrop to dismiss. The stage and the nav buttons sit above
    // it, so this only fires on the surrounding dialog box itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      stage.replaceChildren();
      if (status) status.textContent = '';
    });
  }
</script>
